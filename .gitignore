# Diagnostics kept from development, disabled by rename rather than deleted.
*.disabled

# Local artifacts
node_modules/
*.tgz
output/
recordings/
*.wav

# Secrets and environment files. This plugin needs neither today, but anyone
# editing a fork might add one, and a committed .env is a leaked credential.
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
